# Milestone 1 — data ingestion configuration.
# Never commit real values. Vercel: set these as Project Environment Variables.

# Source spreadsheet (Client_Miner_Model_Summary_FULL).
SHEET_ID=1XySY4bTYTU0XYjndcRlKyBcXLH8n9FiGQtet-iYTRU4

# Preferred live connector. Full service-account JSON on one line.
# Share the spreadsheet with the service account's client_email as Viewer.
# Scope used: https://www.googleapis.com/auth/spreadsheets.readonly
GOOGLE_SERVICE_ACCOUNT=

# Connector precedence. Comma-separated subset of: service_account,public_csv,fixture
# Default below keeps the deployment serving the committed snapshot until
# GOOGLE_SERVICE_ACCOUNT is populated, then live data takes over automatically.
INGEST_SOURCES=service_account,public_csv,fixture

# Seconds to cache a normalized dataset in function memory.
INGEST_CACHE_TTL=300

# ---- Price feed (supplier price lists) ----
# Shared secret for POST /api/pricefeed (manual ingest / forwarding automations).
PRICEFEED_INGEST_SECRET=
# Where observations are kept: memory (default, not durable) or sheet
# (a "PriceFeed" tab in the workbook, written via GOOGLE_SERVICE_ACCOUNT with
# the read-write Sheets scope). Milestone 2's database replaces both.
PRICEFEED_STORE=memory
# Optional: a different spreadsheet for the PriceFeed tab (defaults to SHEET_ID).
PRICEFEED_SHEET_ID=

# ---- WhatsApp Business Platform (Meta Cloud API) webhook: /api/whatsapp ----
# Token you choose; Meta sends it back during webhook verification.
WHATSAPP_VERIFY_TOKEN=
# The Meta app's App Secret; used to verify X-Hub-Signature-256 on every delivery.
WHATSAPP_APP_SECRET=
# Comma-separated WhatsApp IDs (international number, digits only) allowed to feed
# prices, e.g. the colleague who forwards the group's daily list. Empty = allow all.
WHATSAPP_ALLOWED_SENDERS=
